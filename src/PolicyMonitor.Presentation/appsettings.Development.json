{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ConnectionStrings": {
    "PolicyDb": "Server=(localdb)\\mssqllocaldb;Database=PolicyMonitor_Dev;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "WorkerSettings": {
    "PollingIntervalSeconds": 5
  },
  "PdfSettings": {
    "OutputDirectory": "./temp-pdfs-dev",
    "TimeoutSeconds": 30
  },
  "SmtpSettings": {
    "Host": "localhost",
    "Port": 25,
    "EnableSsl": false,
    "FromEmail": "dev@localhost",
    "FromName": "Policy Monitor (DEV)"
  },
  "FileTransferSettings": {
    "DestinationPath": "./archive-pdfs-dev"
  }
}
