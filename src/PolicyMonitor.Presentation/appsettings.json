{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "PolicyDb": "Server=(localdb)\\mssqllocaldb;Database=PolicyMonitor;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "WorkerSettings": {
    "PollingIntervalSeconds": 5,
    "MaxConcurrentProcessing": 10
  },
  "PdfSettings": {
    "OutputDirectory": "./temp-pdfs",
    "TimeoutSeconds": 30,
    "MaxRetries": 3,
    "RetryIntervalSeconds": 10
  },
  "SmtpSettings": {
    "Host": "smtp.company.local",
    "Port": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "FromEmail": "policy-monitor@company.local",
    "FromName": "Policy Status Monitor",
    "TimeoutSeconds": 30,
    "MaxRetries": 3,
    "RetryBackoffSeconds": [30, 120, 300]
  },
  "FileTransferSettings": {
    "DestinationPath": "./archive-pdfs",
    "TimeoutSeconds": 60,
    "MaxRetries": 24,
    "RetryIntervalMinutes": 5
  },
  "AuditSettings": {
    "RetentionYears": 7,
    "EnableMetrics": true
  }
}
